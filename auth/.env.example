# Salin menjadi .env di akar proyek. Semua nilai ini PUBLIK (aman di aplikasi), tetapi .env tetap jangan di-commit.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# Isi 1 hanya jika Microsoft sudah diaktifkan di Firebase (versi web saja)
EXPO_PUBLIC_ENABLE_MICROSOFT=
